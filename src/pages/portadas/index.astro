---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortadaItem from '../../components/portadas/PortadaItem.astro';

const portadas = [
  { id: 1, titulo: 'Portada 1', imagen: '/placeholder.svg?height=300&width=220' },
  { id: 2, titulo: 'Portada 2', imagen: '/placeholder.svg?height=300&width=220' },
  { id: 3, titulo: 'Portada 3', imagen: '/placeholder.svg?height=300&width=220' },
  { id: 4, titulo: 'Portada 4', imagen: '/placeholder.svg?height=300&width=220' },
  { id: 5, titulo: 'Portada 5', imagen: '/placeholder.svg?height=300&width=220' },
  { id: 6, titulo: 'Portada 6', imagen: '/placeholder.svg?height=300&width=220' },
  { id: 7, titulo: 'Portada 7', imagen: '/placeholder.svg?height=300&width=220' },
  { id: 8, titulo: 'Portada 8', imagen: '/placeholder.svg?height=300&width=220' },
];
---

<BaseLayout title="Portadas" description="Galería creativa de portadas diseñadas por Nexome">
  <section aria-label="Galería de portadas">
    <h1>Portadas</h1>
    <p>Galería creativa de portadas diseñadas por nosotros mismos.</p>
    <ul>
      {portadas.map((portada) => (
        <li>
          <PortadaItem {...portada} />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
