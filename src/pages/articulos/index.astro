---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticuloCard from '../../components/features/blog/ArticuloCard.astro';
import FiltrosArticulos from '../../components/features/blog/FiltrosArticulos.astro';
import Paginacion from '../../components/features/blog/Paginacion.astro';

const articulos = [
  { id: 1, titulo: 'Artículo 1', autor: 'Autor 1', fecha: '2026-04-18', categoria: 'Tecnología', imagen: '/placeholder.svg?height=220&width=350' },
  { id: 2, titulo: 'Artículo 2', autor: 'Autor 2', fecha: '2026-04-17', categoria: 'Cultura', imagen: '/placeholder.svg?height=220&width=350' },
  { id: 3, titulo: 'Artículo 3', autor: 'Autor 3', fecha: '2026-04-16', categoria: 'Ciencia', imagen: '/placeholder.svg?height=220&width=350' },
  { id: 4, titulo: 'Artículo 4', autor: 'Autor 4', fecha: '2026-04-15', categoria: 'Arte', imagen: '/placeholder.svg?height=220&width=350' },
  { id: 5, titulo: 'Artículo 5', autor: 'Autor 5', fecha: '2026-04-14', categoria: 'Tecnología', imagen: '/placeholder.svg?height=220&width=350' },
  { id: 6, titulo: 'Artículo 6', autor: 'Autor 6', fecha: '2026-04-13', categoria: 'Cultura', imagen: '/placeholder.svg?height=220&width=350' },
];

const paginaActual = 1;
const totalPaginas = 3;
---

<BaseLayout title="Artículos" description="Explora todos los artículos de Nexome">
  <section aria-label="Artículos" class="section-shell pt-32 lg:pt-40">
    <div class="mb-10 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <span class="section-kicker">Archivo editorial</span>
        <h1 class="section-title mt-5">Artículos</h1>
        <p class="section-copy mt-4">
          Una colección presentada con una estructura más sólida y una lectura más elegante para la
          revista digital.
        </p>
      </div>
      <a href="/" class="editorial-button ghost">Volver al inicio</a>
    </div>

    <FiltrosArticulos />
    <ul class="mt-8 grid gap-6 lg:grid-cols-2 xl:grid-cols-3">
      {articulos.map((articulo) => (
        <li class="h-full">
          <ArticuloCard {...articulo} />
        </li>
      ))}
    </ul>
    <Paginacion paginaActual={paginaActual} totalPaginas={totalPaginas} />
  </section>
</BaseLayout>
