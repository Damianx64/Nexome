---

---

<section
  aria-label="Hero"
  class="relative isolate overflow-hidden px-6 pb-16 pt-32 sm:px-8 lg:min-h-[96svh] lg:px-10 lg:pb-24 lg:pt-40"
>
  <div class="absolute inset-0 -z-30 bg-[url('/fondo.webp')] bg-cover bg-center bg-no-repeat"></div>
  <div class="absolute inset-0 -z-20 bg-[radial-gradient(circle_at_top,rgba(156,245,255,0.34),transparent_24%),linear-gradient(120deg,rgba(2,12,18,0.22),rgba(3,12,24,0.74)_45%,rgba(6,18,27,0.94)_100%)]"></div>
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(3,15,24,0.22)_0%,rgba(3,14,24,0.34)_35%,rgba(6,17,27,0.96)_100%)]"></div>
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute left-[8%] top-[18%] h-44 w-44 rounded-full border border-cyan-100/25 bg-cyan-100/12 blur-3xl"></div>
    <div class="absolute right-[10%] top-[20%] h-56 w-56 rounded-full border border-emerald-100/18 bg-emerald-100/10 blur-3xl"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-[linear-gradient(180deg,transparent,rgba(4,12,20,0.92))]"></div>
  </div>
  <div class="pointer-events-none absolute inset-x-[12%] top-24 -z-10 h-56 rounded-full bg-cyan-200/18 blur-3xl lg:top-28 lg:h-72"></div>
  <div class="pointer-events-none absolute -right-16 bottom-10 -z-10 h-64 w-64 rounded-full bg-emerald-200/10 blur-3xl lg:h-80 lg:w-80"></div>

  <div class="mx-auto flex min-h-[62svh] w-full max-w-7xl items-end lg:min-h-[76svh]">
    <div class="grid w-full gap-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end">
      <div class="max-w-4xl">
        <span class="section-kicker mb-5">Nexome Digital Magazine</span>
        <h1 class="max-w-4xl text-5xl font-bold tracking-[-0.08em] text-white sm:text-6xl lg:text-[6.5rem] lg:leading-[0.9]">
          Estética Fritiger Aero y Y2K para una revista que se siente futura.
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-7 text-cyan-50/78 sm:text-lg lg:mt-8 lg:text-[1.28rem] lg:leading-8">
          Editorial digital con brillo líquido, narrativa visual pulida y una interfaz que mezcla
          nostalgia tecnológica.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4 lg:mt-12">
          <a href="/articulos" class="editorial-button">
            Ver artículos
          </a>
          <a href="/portadas" class="editorial-button ghost">
            Explorar portadas
          </a>
        </div>
      </div>

      <div class="content-card rounded-[2rem] p-5 lg:mb-4">
        <div class="absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-white/70 to-transparent"></div>
        <p class="text-xs font-semibold uppercase tracking-[0.34em] text-cyan-50/56">
          Curaduría visual
        </p>
        <div class="mt-5 space-y-4">
          <div class="rounded-[1.6rem] border border-white/12 bg-slate-950/18 p-4">
            <p class="text-3xl font-bold text-white">03</p>
            <p class="mt-1 text-sm leading-6 text-cyan-50/70">
              Fuentes editoriales con roles claros para portada, UI y lectura.
            </p>
          </div>
          <div class="rounded-[1.6rem] border border-white/12 bg-slate-950/18 p-4">
            <p class="text-3xl font-bold text-white">Aero</p>
            <p class="mt-1 text-sm leading-6 text-cyan-50/70">
              Capas translúcidas, luces suaves y contraste pensado para una experiencia premium.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
