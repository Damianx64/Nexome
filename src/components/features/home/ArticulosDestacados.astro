---
const articulos = [
  {
    id: 1,
    titulo: 'Cómo construir una identidad visual que se sienta líquida y editorial',
    autor: 'Equipo Nexome',
    fecha: '18 de abril, 2026',
    categoria: 'Dirección de arte',
    imagen: '/placeholder.svg?height=200&width=350',
  },
  {
    id: 2,
    titulo: 'La nostalgia digital como lenguaje: del gloss Y2K a la interfaz contemporánea',
    autor: 'Redacción Nexome',
    fecha: '17 de abril, 2026',
    categoria: 'Cultura visual',
    imagen: '/placeholder.svg?height=200&width=350',
  },
  {
    id: 3,
    titulo: 'Tipografías que elevan una revista online sin sacrificar legibilidad',
    autor: 'Mesa editorial',
    fecha: '16 de abril, 2026',
    categoria: 'Diseño editorial',
    imagen: '/placeholder.svg?height=200&width=350',
  },
];
---

<section aria-label="Artículos destacados" class="section-shell">
  <div class="mb-10 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <span class="section-kicker">Edición destacada</span>
      <h2 class="section-title mt-5">Historias para una revista digital con carácter.</h2>
      <p class="section-copy mt-4">
        Un frente editorial claro, tipografía con jerarquía y superficies con profundidad para
        presentar cada artículo como una pieza principal.
      </p>
    </div>
    <a href="/articulos" class="editorial-button ghost">Ir al archivo</a>
  </div>

  <ul class="grid gap-6 lg:grid-cols-3">
    {articulos.map((articulo) => (
      <li class="h-full">
        <article class="content-card flex h-full flex-col rounded-[2rem]">
          <a href={`/articulos/${articulo.id}`} class="flex h-full flex-col">
            <div class="relative overflow-hidden rounded-t-[2rem]">
              <img
                src={articulo.imagen}
                alt={articulo.titulo}
                width="350"
                height="200"
                class="h-56 w-full object-cover"
              />
              <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent_15%,rgba(4,15,24,0.78)_100%)]"></div>
              <span class="info-chip absolute left-5 top-5">{articulo.categoria}</span>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-2xl leading-tight text-white">{articulo.titulo}</h3>
              <p class="mt-4 body-copy text-base leading-7 text-cyan-50/68">
                La estética visual acompaña la lectura con una estructura limpia, tecnológica y
                atmosférica.
              </p>
              <p class="mt-auto flex items-center justify-between gap-4 pt-6 text-sm tracking-[0.14em] text-cyan-50/60">
                <span class="uppercase">{articulo.autor}</span>
                <time datetime={articulo.fecha}>{articulo.fecha}</time>
              </p>
            </div>
          </a>
        </article>
      </li>
    ))}
  </ul>
</section>
