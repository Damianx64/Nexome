---
interface Props {
  paginaActual: number;
  totalPaginas: number;
}

const { paginaActual, totalPaginas } = Astro.props;
const paginas = Array.from({ length: totalPaginas }, (_, i) => i + 1);
---

<nav aria-label="Paginación" class="mt-12">
  <ul class="flex flex-wrap items-center justify-center gap-3">
    {paginaActual > 1 && (
      <li>
        <a
          href={`/articulos?pagina=${paginaActual - 1}`}
          aria-label="Página anterior"
          class="editorial-button ghost px-5 py-2.5"
        >
          Anterior
        </a>
      </li>
    )}
    {paginas.map((num) => (
      <li>
        <a
          href={`/articulos?pagina=${num}`}
          aria-label={`Página ${num}`}
          aria-current={num === paginaActual ? 'page' : undefined}
          class:list={[
            'inline-flex h-12 w-12 items-center justify-center rounded-full border text-sm font-semibold uppercase tracking-[0.18em] transition',
            num === paginaActual
              ? 'border-cyan-100/70 bg-cyan-100/90 text-slate-950 shadow-[0_12px_26px_rgba(117,231,255,0.25)]'
              : 'border-white/15 bg-white/8 text-cyan-50 hover:border-cyan-100/34',
          ]}
        >
          {num}
        </a>
      </li>
    ))}
    {paginaActual < totalPaginas && (
      <li>
        <a
          href={`/articulos?pagina=${paginaActual + 1}`}
          aria-label="Página siguiente"
          class="editorial-button ghost px-5 py-2.5"
        >
          Siguiente
        </a>
      </li>
    )}
  </ul>
</nav>
